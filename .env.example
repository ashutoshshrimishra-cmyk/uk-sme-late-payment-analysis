# PostgreSQL connection string used by the app and Drizzle migrations.
DATABASE_URL=
# Secret used to sign login sessions; use at least 32 bytes.
SESSION_SECRET=
# Passcode for the SME portal role.
SME_PASSCODE=
# Passcode for the financer portal role.
FINANCER_PASSCODE=
# Passcode for the investor portal role.
INVESTOR_PASSCODE=
# PayPal environment: sandbox or live.
PAYPAL_MODE=
# PayPal business account email used for invoices.
PAYPAL_BUSINESS_EMAIL=
# PayPal REST application client ID.
PAYPAL_CLIENT_ID=
# PayPal REST application client secret.
PAYPAL_CLIENT_SECRET=
# Google Gemini API key for risk explanations and document extraction.
GEMINI_API_KEY=
# Optional Gemini model override.
GEMINI_MODEL=
# Optional Companies House number used for demo buyer lookups.
DEMO_BUYER_COMPANY_NUMBER=
# Companies House API key for company lookups.
COMPANIES_HOUSE_API_KEY=
